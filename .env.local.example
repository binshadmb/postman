RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_PAYPAL_DONATE_BUTTON_ID=your_donate_hosted_button_id

# Required for the real checkout (public/client.js) — separate from the
# demo /pay page above. PAYPAL_CLIENT_ID here can be the same value as
# NEXT_PUBLIC_PAYPAL_CLIENT_ID; PAYPAL_CLIENT_SECRET must stay server-only.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=live
